+/** Map async work over array with concurrency limit. Preserves order. */
+async function mapWithConcurrency(items, fn, concurrency = 64, onProgress) {
+    const results = new Array(items.length);
+    let loaded = 0;
+    let index = 0;
+    const promises = [];
+    for (let i = 0; i < Math.min(concurrency, items.length); i++) {
+        const promise = (async () => {
+            while (index < items.length) {
+                const idx = index++;
+                results[idx] = await fn(items[idx], idx);
+                loaded++;
+                onProgress?.(loaded, items.length);
+            }
+        })();
+        promises.push(promise);
+    }
+    await Promise.all(promises);
+    return results;
+}
